<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks">

	<!-- ══════════════════════════════════════════════════════
	     ComboBox — Toggle Button (dropdown arrow area)
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="LauncherPage.ComboBoxToggleTemplate" TargetType="ToggleButton">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="28" />
			</Grid.ColumnDefinitions>
			<Border x:Name="Border" Grid.ColumnSpan="2"
							Background="{StaticResource TB.Sfc.Light.50}"
							BorderBrush="{StaticResource TB.Sfc.Lighter.75}"
							BorderThickness="1" CornerRadius="6"
							SnapsToDevicePixels="True" />
			<Path x:Name="Arrow" Grid.Column="1"
						Data="M0,0 L4,4 8,0"
						Stroke="{StaticResource TB.Txt.Mid}"
						StrokeThickness="1.5"
						HorizontalAlignment="Center" VerticalAlignment="Center" />
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="Border" Property="BorderBrush"
								Value="{StaticResource TB.Sfc.MedLight}" />
				<Setter TargetName="Arrow" Property="Stroke"
								Value="{StaticResource TB.Txt.Bright}" />
			</Trigger>
			<Trigger Property="IsChecked" Value="True">
				<Setter TargetName="Border" Property="BorderBrush"
								Value="{StaticResource TB.Acc.Gold}" />
				<Setter TargetName="Arrow" Property="Stroke"
								Value="{StaticResource TB.Acc.Gold}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<!-- ══════════════════════════════════════════════════════
	     ComboBox — Editable TextBox (for IsEditable=True)
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="LauncherPage.ComboBoxEditableTemplate" TargetType="TextBox">
		<Border x:Name="PART_ContentHost" Focusable="False"
						Background="Transparent" />
	</ControlTemplate>

	<!-- ══════════════════════════════════════════════════════
	     ComboBoxItem — Dropdown row style
	     Dark background, gold border on hover, gold text on select.
	     Matches the ModpacksMenuItem visual language.
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LauncherPageComboBoxItem" TargetType="ComboBoxItem">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBoxItem">
					<Border x:Name="ItemBorder"
									Background="Transparent"
									BorderBrush="Transparent"
									BorderThickness="1"
									CornerRadius="4"
									Padding="10,5"
									Margin="2,1"
									SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Left"
															VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="ItemBorder" Property="Background"
											Value="{StaticResource TB.Sfc.Med}" />
							<Setter TargetName="ItemBorder" Property="BorderBrush"
											Value="{StaticResource TB.Acc.Gold}" />
							<Setter Property="Foreground"
											Value="{StaticResource TB.Acc.Gold}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="ItemBorder" Property="Background"
											Value="{StaticResource TB.Sfc.Med.50}" />
							<Setter TargetName="ItemBorder" Property="BorderBrush"
											Value="{StaticResource TB.Acc.Gold}" />
							<Setter Property="Foreground"
											Value="{StaticResource TB.Acc.Gold}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     ComboBox — Full ControlTemplate
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LauncherPageComboBox" TargetType="ComboBox">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource LauncherPageComboBoxItem}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<ToggleButton x:Name="ToggleButton"
													Template="{StaticResource LauncherPage.ComboBoxToggleTemplate}"
													Focusable="False" ClickMode="Press"
													IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
																	RelativeSource={RelativeSource TemplatedParent}}" />
						<ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
															Content="{TemplateBinding SelectionBoxItem}"
															ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
															ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
															Margin="10,3,28,3"
															VerticalAlignment="Center" HorizontalAlignment="Left" />
						<TextBox x:Name="PART_EditableTextBox"
										 Template="{StaticResource LauncherPage.ComboBoxEditableTemplate}"
										 HorizontalAlignment="Left" VerticalAlignment="Center"
										 Margin="10,3,28,3" Focusable="True" Visibility="Hidden"
										 Background="Transparent"
										 Foreground="{StaticResource TB.Txt.Bright}"
										 CaretBrush="{StaticResource TB.Txt.Bright}"
										 IsReadOnly="{TemplateBinding IsReadOnly}" />
						<Popup x:Name="Popup" Placement="Bottom"
									 IsOpen="{TemplateBinding IsDropDownOpen}"
									 AllowsTransparency="True" Focusable="False"
									 PopupAnimation="Slide">
							<Grid x:Name="DropDown" SnapsToDevicePixels="True"
										MinWidth="{TemplateBinding ActualWidth}"
										MaxHeight="{TemplateBinding MaxDropDownHeight}">
								<Border x:Name="DropDownBorder"
												Background="{StaticResource TB.Sfc.MedDark}"
												BorderBrush="{StaticResource TB.Sfc.Lighter.75}"
												BorderThickness="1" CornerRadius="6"
												Margin="0,2,0,0" />
								<ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
									<StackPanel IsItemsHost="True"
															KeyboardNavigation.DirectionalNavigation="Contained" />
								</ScrollViewer>
							</Grid>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
						</Trigger>
						<Trigger Property="IsEditable" Value="True">
							<Setter Property="IsTabStop" Value="False" />
							<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
							<Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     SearchBox — Full ControlTemplate
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LauncherPageSearchBox" TargetType="TextBox">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="CaretBrush" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
		<Setter Property="AllowDrop" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="Border"
									Background="{StaticResource TB.Sfc.Dark.50}"
									BorderBrush="{StaticResource TB.Sfc.MedDark.50}"
									BorderThickness="1" CornerRadius="6"
									Padding="6,4"
									SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<!--Search icon-->
							<mahIcons:PackIconMaterial x:Name="SearchIcon"
																				Kind="Magnify" Width="14" Height="14"
																				Foreground="{StaticResource TB.Txt.Dim}"
																				VerticalAlignment="Center" Margin="2,0,6,0" />
							<Grid Grid.Column="1">
								<!--Placeholder text-->
								<TextBlock x:Name="Placeholder"
													 Text="Search…"
													 Foreground="{StaticResource TB.Txt.Dim}"
													 VerticalAlignment="Center"
													 IsHitTestVisible="False"
													 Visibility="Collapsed" />
								<ScrollViewer x:Name="PART_ContentHost"
															Focusable="False"
															HorizontalScrollBarVisibility="Hidden"
															VerticalScrollBarVisibility="Hidden"
															VerticalAlignment="Center" />
							</Grid>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="">
							<Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="Text" Value="{x:Null}">
							<Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Border" Property="BorderBrush"
											Value="{StaticResource TB.Sfc.MedLight}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Border" Property="BorderBrush"
											Value="{StaticResource TB.Acc.Gold}" />
							<Setter TargetName="SearchIcon" Property="Foreground"
											Value="{StaticResource TB.Acc.Gold}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Action Button (Install Mods, Unblock DLLs)
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="LauncherPageActionButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Orange}"
						BorderThickness="0" CornerRadius="6"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
												RecognizesAccessKey="True" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="LauncherPageActionButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource LauncherPageActionButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="Height" Value="34" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Play Split Button — Left half (Play icon + label)
	     Gold background. Rounded on left, flat on right.
	     Disabled state uses TB.Sfc.MedLight (grayish-yellow
	     closest to muted gold in the theme palette).
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="PlaySplitButtonLeftTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Gold}"
						BorderThickness="0"
						CornerRadius="6,0,0,6"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
									VerticalAlignment="Center">
				<mahIcons:PackIconMaterial x:Name="PlayIcon" Kind="Play" Width="16" Height="16"
																	Foreground="{StaticResource TB.Txt.Dark}"
																	VerticalAlignment="Center" Margin="0,0,6,0" />
				<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
													RecognizesAccessKey="True" />
			</StackPanel>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Sfc.MedLight}" />
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
				<Setter TargetName="PlayIcon" Property="Foreground"
								Value="{StaticResource TB.Txt.Dim}" />
				<Setter Property="Foreground"
								Value="{StaticResource TB.Txt.Dim}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="PlaySplitButtonLeft" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource PlaySplitButtonLeftTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="MinWidth" Value="140" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Play Split Button — Right half (Dropdown chevron)
	     Gold background. Rounded on right, flat on left.
	     1px left border using Amber as divider.
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="PlaySplitButtonRightTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Gold}"
						BorderThickness="1,0,0,0"
						BorderBrush="{StaticResource TB.Acc.Amber}"
						CornerRadius="0,6,6,0"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Sfc.MedLight}" />
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="PlaySplitButtonRight" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource PlaySplitButtonRightTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     List Header
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="ModsListHeader" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     ListBox
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="ModsListBox" TargetType="ListBox">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ListBoxItem">
					<Setter Property="OverridesDefaultStyle" Value="True" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Center" />
					<Setter Property="Padding" Value="0" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Border x:Name="ItemBorder"
												Background="Transparent"
												BorderBrush="Transparent"
												BorderThickness="1"
												CornerRadius="4"
												Padding="4,2"
												Margin="1"
												SnapsToDevicePixels="True">
									<ContentPresenter HorizontalAlignment="Stretch" />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="ItemBorder" Property="Background"
														Value="{StaticResource TB.Sfc.Med.25}" />
									</Trigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="ItemBorder" Property="Background"
														Value="{StaticResource TB.Sfc.Med.50}" />
										<Setter TargetName="ItemBorder" Property="BorderBrush"
														Value="{StaticResource TB.Acc.Gold}" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBox">
					<Border x:Name="Border"
									Background="{StaticResource TB.Sfc.MedLight.50}"
									BorderBrush="{StaticResource TB.Sfc.Lighter.75}"
									BorderThickness="1" CornerRadius="8"
									Padding="2"
									SnapsToDevicePixels="True">
						<Border CornerRadius="7" ClipToBounds="True">
							<ScrollViewer Focusable="False"
														CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
														HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
														VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
								<StackPanel IsItemsHost="True" Margin="2" />
							</ScrollViewer>
						</Border>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Mod Item DataTemplate
	     ══════════════════════════════════════════════════════ -->
	<DataTemplate x:Key="ModsModItemTemplate">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" Text="{Binding ModuleName}"
								 Foreground="{StaticResource TB.Txt.Bright}"
								 FontFamily="{StaticResource Font.Secondary}" FontSize="13"
								 VerticalAlignment="Center"
								 TextTrimming="CharacterEllipsis" />
			<TextBlock Grid.Column="1" Text="{Binding ModuleVersion}"
								 Foreground="{StaticResource TB.Txt.Mid}"
								 FontFamily="{StaticResource Font.Secondary}" FontSize="12"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Right"
								 Margin="12,0,0,0" />
		</Grid>
	</DataTemplate>

	<!-- ══════════════════════════════════════════════════════
	     ModList Label
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LauncherPageModListLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="Margin" Value="0,0,8,0" />
	</Style>

	<!--End of LauncherPage Resources-->
</ResourceDictionary>

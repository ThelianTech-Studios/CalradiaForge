	<!-- ══════════════════════════════════════════════════════
	     BRUSHES — Accent: Red
	     ══════════════════════════════════════════════════════ -->
	<SolidColorBrush x:Key="TB.Acc.Red"         Color="{StaticResource TC.Acc.Red}" />
	<SolidColorBrush x:Key="TB.Acc.Crimson"     Color="{StaticResource TC.Acc.Crimson}" />
	<SolidColorBrush x:Key="TB.Acc.DarkRed"     Color="{StaticResource TC.Acc.DarkRed}" />
	<SolidColorBrush x:Key="TB.Acc.Maroon"      Color="{StaticResource TC.Acc.Maroon}" />

</ResourceDictionary>
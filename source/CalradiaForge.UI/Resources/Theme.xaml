<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		App-wide theme palette derived from App_Icon.png and the MainWindow background gradient.
		Every page and control style should reference these keys instead of hard-coding hex values.

		Naming convention:
		  TC.*.*     = Theme Color   (Color resource)
		  TB.*.*     = Theme Brush   (SolidColorBrush resource)
		  .75 / .50 / .25  = opacity variant (75%, 50%, 25%)
	-->

	<!-- ══════════════════════════════════════════════════════
	     BACKGROUND GRADIENT STOPS (bottom → top)
	     ══════════════════════════════════════════════════════ -->
	<Color x:Key="TC.Bg.Darkest">#1A1B1A</Color>
	<Color x:Key="TC.Bg.Dark">#281A1B</Color>
	<Color x:Key="TC.Bg.MedDark">#2F1B1A</Color>
	<Color x:Key="TC.Bg.Med">#3B181B</Color>
	<Color x:Key="TC.Bg.MedLight">#451B1C</Color>
	<Color x:Key="TC.Bg.Light">#581719</Color>
	<Color x:Key="TC.Bg.Lighter">#65181B</Color>
	<Color x:Key="TC.Bg.Lightest">#841617</Color>

	<!-- BACKGROUND — 75% opacity (BF) -->
	<Color x:Key="TC.Bg.Darkest.75">#BF1A1B1A</Color>
	<Color x:Key="TC.Bg.Dark.75">#BF281A1B</Color>
	<Color x:Key="TC.Bg.MedDark.75">#BF2F1B1A</Color>
	<Color x:Key="TC.Bg.Med.75">#BF3B181B</Color>
	<Color x:Key="TC.Bg.MedLight.75">#BF451B1C</Color>
	<Color x:Key="TC.Bg.Light.75">#BF581719</Color>
	<Color x:Key="TC.Bg.Lighter.75">#BF65181B</Color>
	<Color x:Key="TC.Bg.Lightest.75">#BF841617</Color>

	<!-- BACKGROUND — 50% opacity (80) -->
	<Color x:Key="TC.Bg.Darkest.50">#801A1B1A</Color>
	<Color x:Key="TC.Bg.Dark.50">#80281A1B</Color>
	<Color x:Key="TC.Bg.MedDark.50">#802F1B1A</Color>
	<Color x:Key="TC.Bg.Med.50">#803B181B</Color>
	<Color x:Key="TC.Bg.MedLight.50">#80451B1C</Color>
	<Color x:Key="TC.Bg.Light.50">#80581719</Color>
	<Color x:Key="TC.Bg.Lighter.50">#8065181B</Color>
	<Color x:Key="TC.Bg.Lightest.50">#80841617</Color>

	<!-- BACKGROUND — 25% opacity (40) -->
	<Color x:Key="TC.Bg.Darkest.25">#401A1B1A</Color>
	<Color x:Key="TC.Bg.Dark.25">#40281A1B</Color>
	<Color x:Key="TC.Bg.MedDark.25">#402F1B1A</Color>
	<Color x:Key="TC.Bg.Med.25">#403B181B</Color>
	<Color x:Key="TC.Bg.MedLight.25">#40451B1C</Color>
	<Color x:Key="TC.Bg.Light.25">#40581719</Color>
	<Color x:Key="TC.Bg.Lighter.25">#4065181B</Color>
	<Color x:Key="TC.Bg.Lightest.25">#40841617</Color>

	<!-- ══════════════════════════════════════════════════════
	     SURFACE / CONTROL (~30 pts brighter than Bg)
	     ══════════════════════════════════════════════════════ -->
	<Color x:Key="TC.Sfc.Darkest">#383939</Color>
	<Color x:Key="TC.Sfc.Dark">#46383A</Color>
	<Color x:Key="TC.Sfc.MedDark">#4D3938</Color>
	<Color x:Key="TC.Sfc.Med">#59363A</Color>
	<Color x:Key="TC.Sfc.MedLight">#63393B</Color>
	<Color x:Key="TC.Sfc.Light">#763538</Color>
	<Color x:Key="TC.Sfc.Lighter">#83363A</Color>
	<Color x:Key="TC.Sfc.Lightest">#A23436</Color>

	<!-- SURFACE — 75% opacity (BF) -->
	<Color x:Key="TC.Sfc.Darkest.75">#BF383939</Color>
	<Color x:Key="TC.Sfc.Dark.75">#BF46383A</Color>
	<Color x:Key="TC.Sfc.MedDark.75">#BF4D3938</Color>
	<Color x:Key="TC.Sfc.Med.75">#BF59363A</Color>
	<Color x:Key="TC.Sfc.MedLight.75">#BF63393B</Color>
	<Color x:Key="TC.Sfc.Light.75">#BF763538</Color>
	<Color x:Key="TC.Sfc.Lighter.75">#BF83363A</Color>
	<Color x:Key="TC.Sfc.Lightest.75">#BFA23436</Color>

	<!-- SURFACE — 50% opacity (80) -->
	<Color x:Key="TC.Sfc.Darkest.50">#80383939</Color>
	<Color x:Key="TC.Sfc.Dark.50">#8046383A</Color>
	<Color x:Key="TC.Sfc.MedDark.50">#804D3938</Color>
	<Color x:Key="TC.Sfc.Med.50">#8059363A</Color>
	<Color x:Key="TC.Sfc.MedLight.50">#8063393B</Color>
	<Color x:Key="TC.Sfc.Light.50">#80763538</Color>
	<Color x:Key="TC.Sfc.Lighter.50">#8083363A</Color>
	<Color x:Key="TC.Sfc.Lightest.50">#80A23436</Color>

	<!-- SURFACE — 25% opacity (40) -->
	<Color x:Key="TC.Sfc.Darkest.25">#40383939</Color>
	<Color x:Key="TC.Sfc.Dark.25">#4046383A</Color>
	<Color x:Key="TC.Sfc.MedDark.25">#404D3938</Color>
	<Color x:Key="TC.Sfc.Med.25">#4059363A</Color>
	<Color x:Key="TC.Sfc.MedLight.25">#4063393B</Color>
	<Color x:Key="TC.Sfc.Light.25">#40763538</Color>
	<Color x:Key="TC.Sfc.Lighter.25">#4083363A</Color>
	<Color x:Key="TC.Sfc.Lightest.25">#40A23436</Color>

	<!-- ══════════════════════════════════════════════════════
	     TEXT
	     ══════════════════════════════════════════════════════ -->
	<Color x:Key="TC.Txt.Bright">#D1DCDF</Color>
	<Color x:Key="TC.Txt.Mid">#818589</Color>
	<Color x:Key="TC.Txt.Dim">#787B7F</Color>
	<Color x:Key="TC.Txt.Dark">#48494D</Color>

	<!-- ══════════════════════════════════════════════════════
	     ACCENT: WARM (gold → deep orange)
	     ══════════════════════════════════════════════════════ -->
	<Color x:Key="TC.Acc.Gold">#FCE196</Color>
	<Color x:Key="TC.Acc.Amber">#FF9729</Color>
	<Color x:Key="TC.Acc.Orange">#FC8821</Color>
	<Color x:Key="TC.Acc.DeepOrange">#FC5924</Color>

	<!-- ══════════════════════════════════════════════════════
	     ACCENT: RED (vivid → deep)
	     ══════════════════════════════════════════════════════ -->
	<Color x:Key="TC.Acc.Red">#E31F12</Color>
	<Color x:Key="TC.Acc.Crimson">#AD100D</Color>
	<Color x:Key="TC.Acc.DarkRed">#8C0B0A</Color>
	<Color x:Key="TC.Acc.Maroon">#530302</Color>

	<!-- ══════════════════════════════════════════════════════
	     BRUSHES — Backgrounds (solid)
	     ══════════════════════════════════════════════════════ -->
	<SolidColorBrush x:Key="TB.Bg.Darkest"      Color="{StaticResource TC.Bg.Darkest}" />
	<SolidColorBrush x:Key="TB.Bg.Dark"         Color="{StaticResource TC.Bg.Dark}" />
	<SolidColorBrush x:Key="TB.Bg.MedDark"      Color="{StaticResource TC.Bg.MedDark}" />
	<SolidColorBrush x:Key="TB.Bg.Med"          Color="{StaticResource TC.Bg.Med}" />
	<SolidColorBrush x:Key="TB.Bg.MedLight"     Color="{StaticResource TC.Bg.MedLight}" />
	<SolidColorBrush x:Key="TB.Bg.Light"        Color="{StaticResource TC.Bg.Light}" />
	<SolidColorBrush x:Key="TB.Bg.Lighter"      Color="{StaticResource TC.Bg.Lighter}" />
	<SolidColorBrush x:Key="TB.Bg.Lightest"     Color="{StaticResource TC.Bg.Lightest}" />

	<!-- BRUSHES — Backgrounds 75% -->
	<SolidColorBrush x:Key="TB.Bg.Darkest.75"   Color="{StaticResource TC.Bg.Darkest.75}" />
	<SolidColorBrush x:Key="TB.Bg.Dark.75"      Color="{StaticResource TC.Bg.Dark.75}" />
	<SolidColorBrush x:Key="TB.Bg.MedDark.75"   Color="{StaticResource TC.Bg.MedDark.75}" />
	<SolidColorBrush x:Key="TB.Bg.Med.75"       Color="{StaticResource TC.Bg.Med.75}" />
	<SolidColorBrush x:Key="TB.Bg.MedLight.75"  Color="{StaticResource TC.Bg.MedLight.75}" />
	<SolidColorBrush x:Key="TB.Bg.Light.75"     Color="{StaticResource TC.Bg.Light.75}" />
	<SolidColorBrush x:Key="TB.Bg.Lighter.75"   Color="{StaticResource TC.Bg.Lighter.75}" />
	<SolidColorBrush x:Key="TB.Bg.Lightest.75"  Color="{StaticResource TC.Bg.Lightest.75}" />

	<!-- BRUSHES — Backgrounds 50% -->
	<SolidColorBrush x:Key="TB.Bg.Darkest.50"   Color="{StaticResource TC.Bg.Darkest.50}" />
	<SolidColorBrush x:Key="TB.Bg.Dark.50"      Color="{StaticResource TC.Bg.Dark.50}" />
	<SolidColorBrush x:Key="TB.Bg.MedDark.50"   Color="{StaticResource TC.Bg.MedDark.50}" />
	<SolidColorBrush x:Key="TB.Bg.Med.50"       Color="{StaticResource TC.Bg.Med.50}" />
	<SolidColorBrush x:Key="TB.Bg.MedLight.50"  Color="{StaticResource TC.Bg.MedLight.50}" />
	<SolidColorBrush x:Key="TB.Bg.Light.50"     Color="{StaticResource TC.Bg.Light.50}" />
	<SolidColorBrush x:Key="TB.Bg.Lighter.50"   Color="{StaticResource TC.Bg.Lighter.50}" />
	<SolidColorBrush x:Key="TB.Bg.Lightest.50"  Color="{StaticResource TC.Bg.Lightest.50}" />

	<!-- BRUSHES — Backgrounds 25% -->
	<SolidColorBrush x:Key="TB.Bg.Darkest.25"   Color="{StaticResource TC.Bg.Darkest.25}" />
	<SolidColorBrush x:Key="TB.Bg.Dark.25"      Color="{StaticResource TC.Bg.Dark.25}" />
	<SolidColorBrush x:Key="TB.Bg.MedDark.25"   Color="{StaticResource TC.Bg.MedDark.25}" />
	<SolidColorBrush x:Key="TB.Bg.Med.25"       Color="{StaticResource TC.Bg.Med.25}" />
	<SolidColorBrush x:Key="TB.Bg.MedLight.25"  Color="{StaticResource TC.Bg.MedLight.25}" />
	<SolidColorBrush x:Key="TB.Bg.Light.25"     Color="{StaticResource TC.Bg.Light.25}" />
	<SolidColorBrush x:Key="TB.Bg.Lighter.25"   Color="{StaticResource TC.Bg.Lighter.25}" />
	<SolidColorBrush x:Key="TB.Bg.Lightest.25"  Color="{StaticResource TC.Bg.Lightest.25}" />

	<!-- ══════════════════════════════════════════════════════
	     BRUSHES — Surfaces (solid)
	     ══════════════════════════════════════════════════════ -->
	<SolidColorBrush x:Key="TB.Sfc.Darkest"     Color="{StaticResource TC.Sfc.Darkest}" />
	<SolidColorBrush x:Key="TB.Sfc.Dark"        Color="{StaticResource TC.Sfc.Dark}" />	
	<SolidColorBrush x:Key="TB.Sfc.MedDark"     Color="{StaticResource TC.Sfc.MedDark}" />
	<SolidColorBrush x:Key="TB.Sfc.Med"         Color="{StaticResource TC.Sfc.Med}" />
	<SolidColorBrush x:Key="TB.Sfc.MedLight"    Color="{StaticResource TC.Sfc.MedLight}" />
	<SolidColorBrush x:Key="TB.Sfc.Light"       Color="{StaticResource TC.Sfc.Light}" />
	<SolidColorBrush x:Key="TB.Sfc.Lighter"     Color="{StaticResource TC.Sfc.Lighter}" />
	<SolidColorBrush x:Key="TB.Sfc.Lightest"    Color="{StaticResource TC.Sfc.Lightest}" />

	<!-- BRUSHES — Surfaces 75% -->
	<SolidColorBrush x:Key="TB.Sfc.Darkest.75"  Color="{StaticResource TC.Sfc.Darkest.75}" />
	<SolidColorBrush x:Key="TB.Sfc.Dark.75"     Color="{StaticResource TC.Sfc.Dark.75}" />
	<SolidColorBrush x:Key="TB.Sfc.MedDark.75"  Color="{StaticResource TC.Sfc.MedDark.75}" />
	<SolidColorBrush x:Key="TB.Sfc.Med.75"      Color="{StaticResource TC.Sfc.Med.75}" />
	<SolidColorBrush x:Key="TB.Sfc.MedLight.75" Color="{StaticResource TC.Sfc.MedLight.75}" />
	<SolidColorBrush x:Key="TB.Sfc.Light.75"    Color="{StaticResource TC.Sfc.Light.75}" />
	<SolidColorBrush x:Key="TB.Sfc.Lighter.75"  Color="{StaticResource TC.Sfc.Lighter.75}" />
	<SolidColorBrush x:Key="TB.Sfc.Lightest.75" Color="{StaticResource TC.Sfc.Lightest.75}" />

	<!-- BRUSHES — Surfaces 50% -->
	<SolidColorBrush x:Key="TB.Sfc.Darkest.50"  Color="{StaticResource TC.Sfc.Darkest.50}" />
	<SolidColorBrush x:Key="TB.Sfc.Dark.50"     Color="{StaticResource TC.Sfc.Dark.50}" />
	<SolidColorBrush x:Key="TB.Sfc.MedDark.50"  Color="{StaticResource TC.Sfc.MedDark.50}" />
	<SolidColorBrush x:Key="TB.Sfc.Med.50"      Color="{StaticResource TC.Sfc.Med.50}" />
	<SolidColorBrush x:Key="TB.Sfc.MedLight.50" Color="{StaticResource TC.Sfc.MedLight.50}" />
	<SolidColorBrush x:Key="TB.Sfc.Light.50"    Color="{StaticResource TC.Sfc.Light.50}" />
	<SolidColorBrush x:Key="TB.Sfc.Lighter.50"  Color="{StaticResource TC.Sfc.Lighter.50}" />
	<SolidColorBrush x:Key="TB.Sfc.Lightest.50" Color="{StaticResource TC.Sfc.Lightest.50}" />

	<!-- BRUSHES — Surfaces 25% -->
	<SolidColorBrush x:Key="TB.Sfc.Darkest.25"  Color="{StaticResource TC.Sfc.Darkest.25}" />
	<SolidColorBrush x:Key="TB.Sfc.Dark.25"     Color="{StaticResource TC.Sfc.Dark.25}" />
	<SolidColorBrush x:Key="TB.Sfc.MedDark.25"  Color="{StaticResource TC.Sfc.MedDark.25}" />
	<SolidColorBrush x:Key="TB.Sfc.Med.25"      Color="{StaticResource TC.Sfc.Med.25}" />
	<SolidColorBrush x:Key="TB.Sfc.MedLight.25" Color="{StaticResource TC.Sfc.MedLight.25}" />
	<SolidColorBrush x:Key="TB.Sfc.Light.25"    Color="{StaticResource TC.Sfc.Light.25}" />
	<SolidColorBrush x:Key="TB.Sfc.Lighter.25"  Color="{StaticResource TC.Sfc.Lighter.25}" />

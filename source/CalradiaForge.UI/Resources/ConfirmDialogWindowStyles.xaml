<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style x:Key="ConfirmDialogWindowFrame" TargetType="Border">
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
					<GradientStop Color="{StaticResource TC.Bg.Light}" Offset="0" />
					<GradientStop Color="{StaticResource TC.Bg.MedDark}" Offset="0.48" />
					<GradientStop Color="{StaticResource TC.Bg.Darkest}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.Lighter.75}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="7" />
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="ConfirmDialogWindowTitleBar" TargetType="Grid">
		<Setter Property="Background" Value="{StaticResource TB.Bg.Lighter}" />
	</Style>

	<Style x:Key="ConfirmDialogWindowTitleBarText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style x:Key="ConfirmDialogWindowFocusVisual" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border BorderBrush="{StaticResource TB.Acc.Gold}"
									BorderThickness="1"
									CornerRadius="4"
									Margin="1">
						<AdornedElementPlaceholder />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="ConfirmDialogWindowCloseButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="Transparent"
						CornerRadius="4"
						SnapsToDevicePixels="True">
			<Path x:Name="IconPath"
						Width="11"
						Height="11"
						Data="M3,3 L11,11 M11,3 L3,11"
						Stroke="{StaticResource TB.Txt.Bright}"
						StrokeThickness="2"
						Stretch="Uniform"
						StrokeStartLineCap="Round"
						StrokeEndLineCap="Round" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TB.Sfc.Light}" />
				<Setter TargetName="IconPath" Property="Stroke" Value="{StaticResource TB.Acc.Red}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="ConfirmDialogWindowCloseButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource ConfirmDialogWindowCloseButtonTemplate}" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource ConfirmDialogWindowFocusVisual}" />
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<Style x:Key="ConfirmDialogWindowBody" TargetType="Grid">
		<Setter Property="Margin" Value="12,8,12,9" />
	</Style>

	<Style x:Key="ConfirmDialogWindowHeading" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style x:Key="ConfirmDialogWindowMessage" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Mid}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Margin" Value="0,2,0,0" />
	</Style>

	<Style x:Key="ConfirmDialogWindowDynamicContentBorder" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource TB.Sfc.MedLight.50}" />
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.Lighter.75}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Padding" Value="5,3" />
		<Setter Property="Margin" Value="0,4,0,0" />
	</Style>

	<Style x:Key="ConfirmDialogWindowDynamicContentText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<ControlTemplate x:Key="ConfirmDialogWindowPrimaryButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Gold}"
						CornerRadius="4"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TB.Sfc.MedLight}" />
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
				<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dim}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="ConfirmDialogWindowPrimaryButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource ConfirmDialogWindowPrimaryButtonTemplate}" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource ConfirmDialogWindowFocusVisual}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="8,3" />
		<Setter Property="Height" Value="27" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<ControlTemplate x:Key="ConfirmDialogWindowSecondaryButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Sfc.MedDark}"
						BorderBrush="{StaticResource TB.Sfc.Lighter.75}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TB.Sfc.Med}" />
				<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource TB.Acc.Red}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="ConfirmDialogWindowSecondaryButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource ConfirmDialogWindowSecondaryButtonTemplate}" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource ConfirmDialogWindowFocusVisual}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Padding" Value="8,3" />
		<Setter Property="Height" Value="27" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
</ResourceDictionary>

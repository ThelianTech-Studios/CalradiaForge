<Page x:Class="CalradiaForge.UI.Pages.ModpacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks"
			mc:Ignorable="d"
			Title="Mod Packs"
			Background="Transparent">

	<Grid Margin="20,10,20,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--Row 0: Header Bar — Label, ComboBox, Actions-->
		<Grid Grid.Row="0" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0"
								 Text="{Binding Translator.Strings.Modpacks_HeaderLabel}"
								 Style="{StaticResource ModpacksPageHeader}"
								 Margin="0,0,10,0" />
			<ComboBox x:Name="ModpackComboBox" Grid.Column="1" MinWidth="160"
								Style="{StaticResource LauncherPageComboBox}"
								DisplayMemberPath="ModpackName"
								ItemsSource="{Binding ModpackList}"
								SelectedIndex="{Binding SelectedModpackIndex}"
								SelectionChanged="ModpackComboBox_SelectionChanged" />
			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<!--Conjoined Split Button: Create New (left) + Template Dropdown (right)-->
				<StackPanel Orientation="Horizontal" Margin="8,0,8,0">
					<Button x:Name="CreateVanillaButton"
									Content="{Binding Translator.Strings.Modpacks_CreateNewButton}"
									Style="{StaticResource SplitButtonLeft}"
									ToolTip="Create a new modpack using the selected template"
									Click="CreateNewButton_Click" />
					<Button x:Name="CreateTemplateDropdown"
									Style="{StaticResource SplitButtonRight}"
									ToolTip="Choose a template for the new modpack"
									Click="CreateTemplateDropdown_Click">
						<mahIcons:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" />
						<Button.ContextMenu>
							<ContextMenu x:Name="TemplateMenu"
													 Style="{StaticResource ModpacksContextMenu}">
								<MenuItem Style="{StaticResource ModpacksMenuItem}"
													Click="CreateFromVanilla_Click">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<mahIcons:PackIconMaterial x:Name="CheckVanilla"
																								 Kind="Check" Width="12" Height="12"
																								 Foreground="{StaticResource TB.Acc.Gold}"
																								 VerticalAlignment="Center"
																								 Margin="0,0,8,0"
																								 Visibility="Visible" />
											<TextBlock Text="{Binding Translator.Strings.Modpacks_TemplateVanilla}"
																 VerticalAlignment="Center" />
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Style="{StaticResource ModpacksMenuItem}"
													Click="CreateFromButterLib_Click">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<mahIcons:PackIconMaterial x:Name="CheckButterLib"
																								 Kind="Check" Width="12" Height="12"
																								 Foreground="{StaticResource TB.Acc.Gold}"
																								 VerticalAlignment="Center"
																								 Margin="0,0,8,0"
																								 Visibility="Collapsed" />
											<TextBlock Text="{Binding Translator.Strings.Modpacks_TemplateButterLib}"
																 VerticalAlignment="Center" />
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Style="{StaticResource ModpacksMenuItem}"
													Click="CreateFromVanillaWarSails_Click">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<mahIcons:PackIconMaterial x:Name="CheckVanillaWarSails"
																								 Kind="Check" Width="12" Height="12"
																								 Foreground="{StaticResource TB.Acc.Gold}"
																								 VerticalAlignment="Center"
																								 Margin="0,0,8,0"
																								 Visibility="Collapsed" />
											<TextBlock Text="{Binding Translator.Strings.Modpacks_TemplateVanillaWarSails}"
																 VerticalAlignment="Center" />
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Style="{StaticResource ModpacksMenuItem}"
													Click="CreateFromButterLibWarSails_Click">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<mahIcons:PackIconMaterial x:Name="CheckButterLibWarSails"
																								 Kind="Check" Width="12" Height="12"
																								 Foreground="{StaticResource TB.Acc.Gold}"
																								 VerticalAlignment="Center"
																								 Margin="0,0,8,0"
																								 Visibility="Collapsed" />
											<TextBlock Text="{Binding Translator.Strings.Modpacks_TemplateButterLibWarSails}"
																 VerticalAlignment="Center" />
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
							</ContextMenu>
						</Button.ContextMenu>
					</Button>
				</StackPanel>
				<Button Content="{Binding Translator.Strings.Modpacks_ImportButton}"
								Style="{StaticResource ModpacksActionButton}"
								ToolTip="Import a CalradiaForge modpack (.json) or Novus Launcher preset (.xml)"
								Margin="0,0,8,0"
								Click="ImportButton_Click" />
				<Button Content="{Binding Translator.Strings.Modpacks_SaveButton}"
								Style="{StaticResource ModpacksActionButton}"
								ToolTip="Overwrite the selected modpack's saved data with the current active load order from the Launcher page"
								IsEnabled="{Binding HasSelection}"
								Click="SaveButton_Click" />
			</StackPanel>
		</Grid>

		<!--Row 1: Dual List Headers + Metadata-->
		<Grid Grid.Row="1" Margin="0,0,0,5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<!--Left header: Active load order-->
			<TextBlock Grid.Column="0"
								 Text="{Binding Translator.Strings.Modpacks_ActiveLoadOrderHeader}"
								 Style="{StaticResource ModpacksSectionHeader}" />
			<!--Right header: Saved modpack data + metadata-->
			<Grid Grid.Column="1" Margin="10,0,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0"
									 Text="{Binding Translator.Strings.Modpacks_SavedDataHeader}"
									 Style="{StaticResource ModpacksSectionHeader}" />
				<StackPanel Grid.Column="1" Orientation="Horizontal"
										HorizontalAlignment="Right" Margin="0,0,10,0">
					<TextBlock Text="{Binding Translator.Strings.Modpacks_ByLabel}"
										 Style="{StaticResource ModpacksMetaLabel}" />
					<TextBlock Text="{Binding SelectedCreatedBy}"
										 Style="{StaticResource ModpacksMetaValue}" Margin="4,0,12,0" />
					<TextBlock Text="{Binding Translator.Strings.Modpacks_UpdatedLabel}"
										 Style="{StaticResource ModpacksMetaLabel}" />
					<TextBlock Text="{Binding SelectedLastUpdated}"
										 Style="{StaticResource ModpacksMetaValue}" />
				</StackPanel>
			</Grid>
		</Grid>

		<!--Row 2: Dual Lists — Active (left, read-only) | Saved (right, editable)-->
		<Grid Grid.Row="2" MinHeight="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<!--Left: Active load order from Launcher page (read-only preview)-->
			<ListBox x:Name="ActiveLoadOrderListBox" Grid.Column="0" Margin="0,0,5,0"
							 Style="{StaticResource ModpacksListBox}"
							 ItemTemplate="{StaticResource ModpackActiveLoadOrderItemTemplate}"
							 ItemsSource="{Binding ActiveLoadOrder}"
							 IsHitTestVisible="False" />
			<!--Right: Saved modpack load order (editable with trash icons)-->
			<ListBox x:Name="LoadOrderListBox" Grid.Column="1" Margin="5,0,0,0"
							 Style="{StaticResource ModpacksListBox}"
							 ItemTemplate="{StaticResource ModpackLoadOrderItemTemplate}"
							 ItemsSource="{Binding EditableLoadOrder}"
							 SelectedIndex="{Binding SelectedEntryIndex}"
							 SelectionChanged="LoadOrderListBox_SelectionChanged" />
		</Grid>

		<!--Row 3: Selected Entry Edit Panel-->
		<Border Grid.Row="3" Margin="0,8,0,0"
						Background="{StaticResource TB.Sfc.Dark.50}"
						BorderBrush="{StaticResource TB.Sfc.MedDark.50}"
						BorderThickness="1" CornerRadius="8"
						Padding="16,10"
						Visibility="{Binding IsEditPanelVisible}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="120" />
				</Grid.ColumnDefinitions>
				<!--Row 0: Module ID + Version-->
				<TextBlock Grid.Row="0" Grid.Column="0"
									 Text="{Binding Translator.Strings.Modpacks_ModuleIdLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,6" />
				<TextBox Grid.Row="0" Grid.Column="1"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding EditModuleId, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,6" />
				<TextBlock Grid.Row="0" Grid.Column="2"
									 Text="{Binding Translator.Strings.Modpacks_VersionLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,6" />
				<TextBox Grid.Row="0" Grid.Column="3"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding EditVersion, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,0,6" />
				<!--Row 1: Name + URL-->
				<TextBlock Grid.Row="1" Grid.Column="0"
									 Text="{Binding Translator.Strings.Modpacks_NameLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,6" />
				<TextBox Grid.Row="1" Grid.Column="1"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding EditModuleName, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,6" />
				<TextBlock Grid.Row="1" Grid.Column="2"
									 Text="{Binding Translator.Strings.Modpacks_UrlLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,6" />
				<TextBox Grid.Row="1" Grid.Column="3"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding EditModuleUrl, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,0,6" />
				<!--Row 2: Save Entry button-->
				<Button Grid.Row="2" Grid.Column="3"
								Content="{Binding Translator.Strings.Modpacks_SaveEntryButton}"
								Style="{StaticResource ModpacksActionButton}"
								HorizontalAlignment="Right"
								Click="SaveEntryButton_Click" />
			</Grid>
		</Border>

		<!--Row 4: Create New Input Panel (hidden by default)-->
		<Border Grid.Row="4" Margin="0,8,0,0"
						Background="{StaticResource TB.Sfc.Dark.50}"
						BorderBrush="{StaticResource TB.Sfc.MedDark.50}"
						BorderThickness="1" CornerRadius="8"
						Padding="16,12"
						Visibility="{Binding IsCreatePanelVisible}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="100" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="0" Grid.Column="0"
									 Text="{Binding Translator.Strings.Modpacks_CreateNameLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,8" />
				<TextBox x:Name="CreateNameBox" Grid.Row="0" Grid.Column="1"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding InputModpackName, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,0,8" />
				<TextBlock Grid.Row="1" Grid.Column="0"
									 Text="{Binding Translator.Strings.Modpacks_CreatedByLabel}"
									 Style="{StaticResource ModpacksMetaLabel}"
									 HorizontalAlignment="Right" Margin="0,0,8,8" />
				<TextBox Grid.Row="1" Grid.Column="1"
								 Style="{StaticResource ModpacksInputTextBox}"
								 Text="{Binding InputCreatedBy, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,0,8" />
				<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
					<Button Content="{Binding Translator.Strings.Modpacks_ConfirmButton}"
									Style="{StaticResource ModpacksActionButton}"
									Margin="0,0,8,0"
									Click="CreateConfirmButton_Click" />
					<Button Content="{Binding Translator.Strings.Modpacks_CancelButton}"
									Style="{StaticResource ModpacksCancelButton}"
									Click="CreateCancelButton_Click" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Page>

<Page x:Class="CalradiaForge.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CalradiaForge.UI"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="Settings"
      Background="Transparent">

	<Grid Margin="20,10,20,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- ════════════════════════════════════════════════════
		     Nav Bar
		     ════════════════════════════════════════════════════ -->
		<ListBox x:Name="SettingsNavBar" Grid.Row="0"
						 Style="{StaticResource SettingsNavBar}"
						 SelectedIndex="0"
						 SelectionChanged="SettingsNav_SelectionChanged">

			<ListBoxItem Style="{StaticResource SettingsNavItem}"
									 Content="{Binding Strings.Settings_GeneralTab, Source={x:Static local:App.Translator}}">
				<ListBoxItem.Tag>
					<mahIcons:PackIconMaterial Kind="CogOutline" Width="18" Height="18" />
				</ListBoxItem.Tag>
			</ListBoxItem>

			<ListBoxItem Style="{StaticResource SettingsNavItem}"
									 Content="{Binding Strings.Settings_GameConfigTab, Source={x:Static local:App.Translator}}">
				<ListBoxItem.Tag>
					<mahIcons:PackIconMaterial Kind="GamepadVariantOutline" Width="18" Height="18" />
				</ListBoxItem.Tag>
			</ListBoxItem>

			<ListBoxItem Style="{StaticResource SettingsNavItem}"
									 Content="{Binding Strings.Settings_ToolsTab, Source={x:Static local:App.Translator}}">
				<ListBoxItem.Tag>
					<mahIcons:PackIconMaterial Kind="WrenchOutline" Width="18" Height="18" />
				</ListBoxItem.Tag>
			</ListBoxItem>

			<ListBoxItem Style="{StaticResource SettingsNavItem}"
									 Content="{Binding Strings.Settings_WipTab, Source={x:Static local:App.Translator}}">
				<ListBoxItem.Tag>
					<mahIcons:PackIconMaterial Kind="HardHat" Width="18" Height="18" />
				</ListBoxItem.Tag>
			</ListBoxItem>

			<ListBoxItem Style="{StaticResource SettingsNavItemRight}"
									 Content="{Binding Strings.Settings_AboutTab, Source={x:Static local:App.Translator}}">
				<ListBoxItem.Tag>
					<mahIcons:PackIconMaterial Kind="InformationOutline" Width="18" Height="18" />
				</ListBoxItem.Tag>
			</ListBoxItem>

		</ListBox>

		<!-- ════════════════════════════════════════════════════
		     Content Area
		     ════════════════════════════════════════════════════ -->
		<Grid Grid.Row="1" Margin="0,8,0,0">

			<!-- PANEL 0 — General -->
			<ScrollViewer x:Name="PanelGeneral"
										VerticalScrollBarVisibility="Auto"
										HorizontalScrollBarVisibility="Disabled"
										Padding="0,12,0,0">
				<StackPanel Margin="4,0">

					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_LanguageHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="200" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
													 Text="{Binding Strings.Settings_LanguageLabel, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsLabel}" />
								<ComboBox x:Name="LanguageComboBox" Grid.Column="1"
													Style="{StaticResource ModsPageComboBox}"
													DisplayMemberPath="DisplayName"
													SelectionChanged="LanguageComboBox_SelectionChanged" />
							</Grid>
							<TextBlock Text="{Binding Strings.Settings_LanguageHint, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsHint}"
												 Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_StartupHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />
							<TextBlock Text="{Binding Strings.Settings_StartupLabel, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsLabel}"
												 Margin="0,0,0,6" />
							<RadioButton x:Name="RadioLastUsed"
													 Content="{Binding Strings.Settings_StartupLastUsed, Source={x:Static local:App.Translator}}"
													 GroupName="ModpackStartup"
													 Style="{StaticResource SettingsRadioButton}"
													 Checked="ModpackStartupMode_Changed" />
							<RadioButton x:Name="RadioAlwaysDefault"
													 Content="{Binding Strings.Settings_StartupAlwaysDefault, Source={x:Static local:App.Translator}}"
													 GroupName="ModpackStartup"
													 Style="{StaticResource SettingsRadioButton}"
													 Checked="ModpackStartupMode_Changed" />
							<RadioButton x:Name="RadioAlwaysAsk"
													 Content="{Binding Strings.Settings_StartupAlwaysAsk, Source={x:Static local:App.Translator}}"
													 GroupName="ModpackStartup"
													 Style="{StaticResource SettingsRadioButton}"
													 Checked="ModpackStartupMode_Changed" />
							<TextBlock Text="{Binding Strings.Settings_StartupHint, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsHint}"
												 Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_DiagnosticsHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />
							<CheckBox x:Name="DebugModeToggle"
							Content="{Binding Strings.Settings_DebugModeLabel, Source={x:Static local:App.Translator}}"
							Style="{StaticResource SettingsToggleSwitch}"
							Checked="DebugMode_Toggled"
							Unchecked="DebugMode_Toggled" />
							<TextBlock Text="{Binding Strings.Settings_DebugModeHint, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsHint}"
												 Margin="0,4,0,0" />
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- PANEL 1 — Game Configuration -->
			<ScrollViewer x:Name="PanelGameConfig"
										Visibility="Collapsed"
										VerticalScrollBarVisibility="Auto"
										HorizontalScrollBarVisibility="Disabled"
										Padding="0,12,0,0">
				<StackPanel Margin="4,0">

					<!-- Game Installation Section -->
					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_GameInstallHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />

							<TextBlock Text="{Binding Strings.Settings_GameFolderLabel, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsLabel}"
												 Margin="0,0,0,4" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Border Grid.Column="0" Style="{StaticResource SettingsPathBorder}">
									<TextBlock x:Name="GameFolderPathText"
														 Style="{StaticResource SettingsPathDisplay}"
														 Text="{Binding GameFolderPath}" />
								</Border>
								<Button Grid.Column="1"
												Content="{Binding Strings.Settings_SelectFolderButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsActionButton}"
												Margin="8,0,0,0"
												Click="SelectGameFolder_Click" />
							</Grid>
							<TextBlock x:Name="GameFolderValidation"
												 Style="{StaticResource SettingsValidationOk}"
												 Text="" />

							<StackPanel x:Name="ExePathSection" Margin="0,12,0,0">
								<TextBlock Text="{Binding Strings.Settings_GameExeLabel, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsLabel}"
													 Margin="0,0,0,4" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" Style="{StaticResource SettingsPathBorder}">
										<TextBlock x:Name="ExePathText"
															 Style="{StaticResource SettingsPathDisplay}"
															 Text="{Binding GameLauncherFilePath}" />
									</Border>
									<Button Grid.Column="1"
													Content="{Binding Strings.Settings_SelectFileButton, Source={x:Static local:App.Translator}}"
													Style="{StaticResource SettingsActionButton}"
													Margin="8,0,0,0"
													Click="SelectGameExe_Click" />
								</Grid>
							</StackPanel>

							<StackPanel x:Name="WorkshopPathSection" Margin="0,12,0,0">
								<TextBlock Text="{Binding Strings.Settings_WorkshopFolderLabel, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsLabel}"
													 Margin="0,0,0,4" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" Style="{StaticResource SettingsPathBorder}">
										<TextBlock x:Name="WorkshopPathText"
															 Style="{StaticResource SettingsPathDisplay}"
															 Text="{Binding SteamWorkshopFolderPath}" />
									</Border>
									<Button x:Name="SelectWorkshopFolderButton" Grid.Column="1"
													Content="{Binding Strings.Settings_SelectFolderButton, Source={x:Static local:App.Translator}}"
													Style="{StaticResource SettingsActionButton}"
													Margin="8,0,0,0"
													Click="SelectWorkshopFolder_Click" />
								</Grid>
							</StackPanel>

						</StackPanel>
					</Border>

					<!-- Script Extender (BLSE) Section -->
					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_BLSEHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />

							<TextBlock Text="{Binding Strings.Settings_BLSEExeLabel, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsLabel}"
												 Margin="0,0,0,4" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Border Grid.Column="0" Style="{StaticResource SettingsPathBorder}">
									<TextBlock x:Name="BLSEExePathText"
														 Style="{StaticResource SettingsPathDisplay}"
														 Text="{Binding BLSEExePath}" />
								</Border>
								<Button Grid.Column="1"
												Content="{Binding Strings.Settings_SelectFileButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsActionButton}"
												Margin="8,0,0,0"
												Click="SelectBLSEExe_Click" />
							</Grid>
							<TextBlock x:Name="BLSEValidation"
												 Style="{StaticResource SettingsValidationOk}"
												 Text="" />
							<TextBlock Text="{Binding Strings.Settings_BLSEHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<!-- Detection Section -->
					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_DetectionHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />
							<StackPanel Orientation="Horizontal">
								<Button Content="{Binding Strings.Settings_DetectGameButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="RedetectGame_Click" />
								<TextBlock Text="{Binding Strings.Settings_DetectGameHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- PANEL 2 — Tools -->
			<ScrollViewer x:Name="PanelTools"
										Visibility="Collapsed"
										VerticalScrollBarVisibility="Auto"
										HorizontalScrollBarVisibility="Disabled"
										Padding="0,12,0,0">
				<StackPanel Margin="4,0">

					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_ModMaintenanceHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />
							<StackPanel Orientation="Horizontal">
								<Button Content="{Binding Strings.Settings_UnblockDllsButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="UnblockDlls_Click" />
								<TextBlock Text="{Binding Strings.Settings_UnblockDllsHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>
							<StackPanel Margin="0,8,0,0">
								<TextBlock x:Name="UnblockLastRunText"
													 Style="{StaticResource SettingsHint}"
													 FontStyle="Normal" />
								<TextBlock x:Name="UnblockResultText"
													 Style="{StaticResource SettingsHint}"
													 FontStyle="Normal" />
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingsSectionBorder}">
						<StackPanel>
							<TextBlock Text="{Binding Strings.Settings_DataManagementHeader, Source={x:Static local:App.Translator}}"
												 Style="{StaticResource SettingsSectionHeader}" />

							<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
								<Button Content="{Binding Strings.Settings_ClearCacheButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="ClearModCache_Click" />
								<TextBlock Text="{Binding Strings.Settings_ClearCacheHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>

							<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
								<Button Content="{Binding Strings.Settings_OpenConfigButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="OpenConfigFolder_Click" />
								<TextBlock Text="{Binding Strings.Settings_OpenConfigHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>

							<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
								<Button Content="{Binding Strings.Settings_OpenLogsButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="OpenLogsFolder_Click" />
								<TextBlock Text="{Binding Strings.Settings_OpenLogsHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>

							<StackPanel Orientation="Horizontal">
								<Button Content="{Binding Strings.Settings_OpenModpacksButton, Source={x:Static local:App.Translator}}"
												Style="{StaticResource SettingsToolButton}"
												Click="OpenModpacksFolder_Click" />
								<TextBlock Text="{Binding Strings.Settings_OpenModpacksHint, Source={x:Static local:App.Translator}}"
													 Style="{StaticResource SettingsHint}"
													 VerticalAlignment="Center"
													 Margin="12,0,0,0"
													 MaxWidth="400" />
							</StackPanel>

						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- PANEL 3 — WIP -->
			<Grid x:Name="PanelWip" Visibility="Collapsed">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<mahIcons:PackIconMaterial Kind="Wrench" Width="48" Height="48"
																		 Foreground="{StaticResource TB.Txt.Dim}"
																		 HorizontalAlignment="Center"
																		 Margin="0,0,0,16" />
					<TextBlock Text="{Binding Strings.Settings_WipTitle, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Txt.Mid}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="16" FontWeight="SemiBold"
										 HorizontalAlignment="Center"
										 TextAlignment="Center" />
					<TextBlock Text="{Binding Strings.Settings_WipDescription, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Txt.Dim}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="13"
										 HorizontalAlignment="Center"
										 TextAlignment="Center"
										 Margin="0,12,0,0"
										 LineHeight="20" />
					<TextBlock Text="{Binding Strings.Settings_WipStayTuned, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Acc.Gold}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="13" FontWeight="SemiBold"
										 HorizontalAlignment="Center"
										 Margin="0,16,0,0" />
				</StackPanel>
			</Grid>

			<!-- PANEL 4 — About -->
			<ScrollViewer x:Name="PanelAbout"
										Visibility="Collapsed"
										VerticalScrollBarVisibility="Auto"
										HorizontalScrollBarVisibility="Disabled"
										Padding="0,12,0,0">
				<StackPanel HorizontalAlignment="Center" MaxWidth="500">
					<Image Source="/Resources/CFIcon.png" Width="72" Height="72"
       HorizontalAlignment="Center" Margin="0,10,0,8" />
					<TextBlock Text="CalradiaForge"
										 Style="{StaticResource SettingsAboutTitle}" />
					<TextBlock x:Name="VersionText"
										 Style="{StaticResource SettingsAboutVersion}" />

					<Separator Margin="0,16" Background="{StaticResource TB.Sfc.MedDark.50}" />

					<TextBlock Text="{Binding Strings.Settings_AboutDescription, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Txt.Bright}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="14"
										 HorizontalAlignment="Center"
										 TextAlignment="Center" />
					<TextBlock Text="{Binding Strings.Settings_AboutTagline, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Acc.Gold}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="13" FontStyle="Italic"
										 HorizontalAlignment="Center"
										 Margin="0,4,0,0" />

					<Separator Margin="0,16" Background="{StaticResource TB.Sfc.MedDark.50}" />

					<Grid HorizontalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0" Grid.Column="0"
											 Text="{Binding Strings.Settings_AboutPublisherLabel, Source={x:Static local:App.Translator}}"
											 Style="{StaticResource SettingsAboutLabel}" Margin="0,0,0,8" />
						<TextBlock Grid.Row="0" Grid.Column="1" Text="ThelianTech™"
											 Style="{StaticResource SettingsAboutValue}" Margin="8,0,0,8" />

						<TextBlock Grid.Row="1" Grid.Column="0"
											 Text="{Binding Strings.Settings_AboutLicenseLabel, Source={x:Static local:App.Translator}}"
											 Style="{StaticResource SettingsAboutLabel}" Margin="0,0,0,8" />
						<Button Grid.Row="1" Grid.Column="1"
										Content="{Binding Strings.Settings_AboutViewLicense, Source={x:Static local:App.Translator}}"
										Style="{StaticResource SettingsToolButton}"
										Height="28" Padding="10,4" FontSize="12"
										Margin="8,0,0,8"
										Click="ViewLicense_Click" />

						<TextBlock Grid.Row="2" Grid.Column="0"
											 Text="{Binding Strings.Settings_AboutGitHubLabel, Source={x:Static local:App.Translator}}"
											 Style="{StaticResource SettingsAboutLabel}" />
						<Button Grid.Row="2" Grid.Column="1"
										Content="{Binding Strings.Settings_AboutViewGitHub, Source={x:Static local:App.Translator}}"
										Style="{StaticResource SettingsToolButton}"
										Height="28" Padding="10,4" FontSize="12"
										Margin="8,0,0,0"
										Click="ViewGitHub_Click" />
					</Grid>

					<Separator Margin="0,16" Background="{StaticResource TB.Sfc.MedDark.50}" />

					<TextBlock Text="{Binding Strings.Settings_AboutCopyright, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Txt.Dim}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="11"
										 HorizontalAlignment="Center" />
					<TextBlock Text="{Binding Strings.Settings_AboutDisclaimer, Source={x:Static local:App.Translator}}"
										 Foreground="{StaticResource TB.Txt.Dim}"
										 FontFamily="{StaticResource Font.Secondary}"
										 FontSize="11"
										 HorizontalAlignment="Center"
										 Margin="0,2,0,20" />

				</StackPanel>
			</ScrollViewer>

		</Grid>
	</Grid>
</Page>

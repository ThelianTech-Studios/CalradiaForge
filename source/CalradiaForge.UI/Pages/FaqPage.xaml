<Page x:Class="CalradiaForge.UI.Pages.FaqPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="F.A.Q."
      Background="Transparent">

    <Grid Margin="20,10,20,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <mahIcons:PackIconMaterial Kind="ChatQuestion" Width="24" Height="24"
                                                                 Foreground="{StaticResource TB.Acc.Gold}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="{Binding Translator.Strings.Faq_PageTitle}"
                                     Foreground="{StaticResource TB.Txt.Bright}"
                                     FontFamily="{StaticResource Font.Secondary}"
                                     FontSize="20" FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- FAQ Content -->
        <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Visible"
                                    HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,0">

                <!-- Q1 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q1_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q1_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q1_Answer2}" />
                        <TextBlock Style="{StaticResource SettingsHint}" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q1_Hint}" />
                    </StackPanel>
                </Border>

                <!-- Q2 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q2_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q2_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q2_Answer2}" />
                    </StackPanel>
                </Border>

                <!-- Q3 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q3_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q3_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q3_Answer2}" />
                        <TextBlock Style="{StaticResource SettingsHint}" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q3_Hint}" />
                    </StackPanel>
                </Border>

                <!-- Q4 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q4_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q4_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q4_Answer2}" />
						<TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q4_Answer3}" />
						<TextBlock Style="{StaticResource SettingsHint}" TextWrapping="Wrap"
											 Text="{Binding Translator.Strings.Faq_Q4_Hint}" />
					</StackPanel>
                </Border>

                <!-- Q5 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q5_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q5_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q5_Answer2}" />
                        <TextBlock Style="{StaticResource SettingsHint}" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q5_Hint}" />
                    </StackPanel>
                </Border>

                <!-- Q6 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q6_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q6_Answer1}" />
						<TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q6_Answer2}" />
						<TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
																 Text="{Binding Translator.Strings.Faq_Q6_Answer3}" />
						<TextBlock Style="{StaticResource SettingsHint}" TextWrapping="Wrap"
																 Text="{Binding Translator.Strings.Faq_Q6_Hint}" />
					</StackPanel>
                </Border>

                <!-- Q7 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q7_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q7_Answer1}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q7_Answer2}" />
                    </StackPanel>
                </Border>

                <!-- Q8 -->
                <Border Style="{StaticResource SettingsSectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Translator.Strings.Faq_Q8_Title}"
                                             Style="{StaticResource SettingsSectionHeader}" />
                        <TextBlock Style="{StaticResource SettingsLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                             Text="{Binding Translator.Strings.Faq_Q8_Answer1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="OpenGitHubIssuesButton"
                                            Content="{Binding Translator.Strings.Faq_Q8_OpenIssuesButton}"
                                            Style="{StaticResource SettingsToolButton}"
                                            Click="OpenGitHubIssues_Click" />
                            <TextBlock Style="{StaticResource SettingsHint}"
                                                 VerticalAlignment="Center" Margin="12,0,0,0"
                                                 Text="{Binding Translator.Strings.Faq_Q8_OpenIssuesHint}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                             Text="{Binding Translator.Strings.Faq_Q8_Hint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

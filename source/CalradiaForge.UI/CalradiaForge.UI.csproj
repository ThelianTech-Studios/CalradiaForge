<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CalradiaForge.UI.App</StartupObject>
    <RootNamespace>CalradiaForge.UI</RootNamespace>
		<AssemblyName>CalradiaForge</AssemblyName>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <SignAssembly>False</SignAssembly>
    <Title>CalradiaForge Launcher</Title>
    <Authors>ThelianTech</Authors>
    <Product>$(Title)</Product>
    <Copyright>Copyright © 2026 ThelianTech™</Copyright>
    <Description>An alternative game launcher for Mount &amp; Blade II: Bannerlord</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSymbols>False</IncludeSymbols>
    <PackageProjectUrl>https://github.com/ThelianTech/CalradiaForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ThelianTech/CalradiaForge</RepositoryUrl>
    <PackageReleaseNotes>Beta v0.12.15</PackageReleaseNotes>
    <Version>0.12.15</Version>
    <PackageLicenseFile>EULA.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<ApplicationIcon>Resources\CalradiaForge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\CFIcon.png" />
    <None Remove="Resources\CalradiaForge.ico" />
    <None Remove="Resources\EULA.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <!-- Core compiles the Debug sink behind #if DEBUG; the executable also
       carries the private runtime asset so Debug output can load it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalradiaForge.Core\CalradiaForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\CFIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\CalradiaForge.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Copy language JSON files and manifest to output Languages\ folder -->
  <ItemGroup>
    <None Include="..\Languages\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Languages" />
  </ItemGroup>

  <!-- Embed EULA into assembly/single-file executable -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\EULA.txt">
      <LogicalName>CalradiaForge.Resources.EULA.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

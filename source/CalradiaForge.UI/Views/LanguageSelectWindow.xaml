<Window x:Class="CalradiaForge.UI.Views.LanguageSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalradiaForge - Language Selection"
        Width="400" Height="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Icon="/Resources/CalradiaForge.ico">
	<Control.Background>
		<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
			<GradientStop Color="{StaticResource TC.Bg.Lightest}" Offset="0.0" />
			<GradientStop Color="{StaticResource TC.Bg.Lighter}" Offset="0.1" />
			<GradientStop Color="{StaticResource TC.Bg.Light}" Offset="0.2" />
			<GradientStop Color="{StaticResource TC.Bg.MedLight}" Offset="0.3" />
			<GradientStop Color="{StaticResource TC.Bg.Med}" Offset="0.4" />
			<GradientStop Color="{StaticResource TC.Bg.MedDark}" Offset="0.5" />
			<GradientStop Color="{StaticResource TC.Bg.Dark}" Offset="0.6" />
			<GradientStop Color="{StaticResource TC.Bg.Darkest}" Offset="1.0" />
		</LinearGradientBrush>
	</Control.Background>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Title Bar -->
		<Grid Grid.Row="0" Style="{StaticResource LangSelectTitleBar}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
									Margin="10,0,5,0">
				<Image Source="/Resources/CFIcon.png" Width="30" Height="30" Margin="0,0,8,0" />
				<TextBlock Text="CalradiaForge" VerticalAlignment="Center"
									 Style="{StaticResource LangSelectTitleBarText}" />
			</StackPanel>

			<Border Grid.Column="1" Background="Transparent"
							MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

			<Button Grid.Column="2" Click="CloseButton_Click"
							Style="{StaticResource TitleBarCloseButton}"
							ToolTip="Close" />
		</Grid>

		<!-- Content -->
		<Grid Grid.Row="1" Margin="24,16,24,24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0"
								 Text="Choose Display Language"
								 Style="{StaticResource LangSelectWindowTitle}" />

			<TextBlock Grid.Row="1"
								 Margin="0,2,0,12"
								 Text="Select your preferred language before the app and EULA are shown."
								 Style="{StaticResource LangSelectSubtitle}" />

			<Border Grid.Row="2" Style="{StaticResource LangSelectPanelBorder}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
										 Text="Language:"
										 Style="{StaticResource LangSelectLabel}" />

					<ComboBox x:Name="LanguageComboBox"
										Grid.Column="2"
										Style="{StaticResource ModsPageComboBox}"
										DisplayMemberPath="DisplayName"
										SelectionChanged="LanguageComboBox_SelectionChanged" />
				</Grid>
			</Border>

			<TextBlock Grid.Row="3"
								 Margin="0,10,0,0"
								 Text="Tip: You can change this again later in Settings."
								 Style="{StaticResource LangSelectSubtitle}" />

			<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
				<Button x:Name="ContinueButton"
								Content="Continue"
								Style="{StaticResource LangSelectContinueButton}"
								Click="ContinueButton_Click" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>

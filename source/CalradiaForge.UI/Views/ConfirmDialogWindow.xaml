<Window x:Class="CalradiaForge.UI.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Width="300"
        Height="169"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Icon="/Resources/CalradiaForge.ico">
	<Border Style="{StaticResource ConfirmDialogWindowFrame}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="32" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Style="{StaticResource ConfirmDialogWindowTitleBar}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
					<Image Source="/Resources/CFIcon.png" Width="20" Height="20" Margin="0,0,6,0" />
					<TextBlock Text="{Binding WindowTitle, Mode=OneTime}"
										 Style="{StaticResource ConfirmDialogWindowTitleBarText}" />
				</StackPanel>

				<Border Grid.Column="1"
								Background="Transparent"
								MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

				<Button Grid.Column="2"
								Style="{StaticResource ConfirmDialogWindowCloseButton}"
								Click="CloseButton_Click" />
			</Grid>

			<Grid Grid.Row="1" Style="{StaticResource ConfirmDialogWindowBody}">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ScrollViewer Grid.Row="0"
											VerticalScrollBarVisibility="Auto"
											HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<TextBlock Text="{Binding Heading, Mode=OneTime}"
											 Style="{StaticResource ConfirmDialogWindowHeading}" />
						<TextBlock Text="{Binding Message, Mode=OneTime}"
											 Style="{StaticResource ConfirmDialogWindowMessage}" />
						<Border>
							<Border.Style>
								<Style TargetType="Border"
											 BasedOn="{StaticResource ConfirmDialogWindowDynamicContentBorder}">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasDynamicContent, Mode=OneTime}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock Text="{Binding DynamicContent, Mode=OneTime}"
												 Style="{StaticResource ConfirmDialogWindowDynamicContentText}" />
						</Border>
					</StackPanel>
				</ScrollViewer>

				<Grid Grid.Row="1" Margin="0,6,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Button Grid.Column="0"
									Content="{Binding PrimaryButtonText, Mode=OneTime}"
									Style="{StaticResource ConfirmDialogWindowPrimaryButton}"
									Click="PrimaryButton_Click" />
					<Button Grid.Column="2"
									Content="{Binding SecondaryButtonText, Mode=OneTime}"
									Style="{StaticResource ConfirmDialogWindowSecondaryButton}"
									Click="SecondaryButton_Click" />
				</Grid>
			</Grid>
		</Grid>
	</Border>
</Window>

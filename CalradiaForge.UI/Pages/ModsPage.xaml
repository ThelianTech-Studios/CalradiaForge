<Page x:Class="CalradiaForge.UI.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			xmlns:local="clr-namespace:CalradiaForge.UI"
			xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
			xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks"
			xmlns:dd="urn:gong-wpf-dragdrop"
			mc:Ignorable="d"
			Title="Mods"
			Background="Transparent">

	<Grid Margin="20,10,20,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--Row 0: ModPack Selection & Action Buttons-->
		<Grid Grid.Row="0" Margin="0,0,0,18">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" Text="ModPacks:"
								 Style="{StaticResource ModsPageModListLabel}" />
			<ComboBox x:Name="ModPackComboBox" Grid.Column="1" MinWidth="120"
								Style="{StaticResource ModsPageComboBox}"
								DisplayMemberPath="ModpackName"
								ItemsSource="{Binding ModpackList}"
								SelectedIndex="{Binding SelectedModpackIndex}"
								SelectionChanged="ModPack_SelectionChanged" />
			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<Button Content="Install Mods" Margin="8,0,0,0"
								Style="{StaticResource ModsPageActionButton}"
								ToolTip="Install mods from an archive or folder"
								Click="InstallModsButton_Click" />
			</StackPanel>
		</Grid>

		<!--Row 1: List Headers & Search-->
		<Grid Grid.Row="1" Margin="0,0,0,5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" Text="Load Order"
								 Style="{StaticResource ModsListHeader}" />
			<Grid Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="200" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="Available Mods"
									 Style="{StaticResource ModsListHeader}" />
				<TextBox x:Name="SearchBox" Grid.Column="1"
								 Style="{StaticResource ModsPageSearchBox}"
								 Margin="0,0,10,0"
								 TextChanged="SearchBox_TextChanged"
								 GotFocus="SearchBox_GotFocus" />
				<Button Grid.Column="2" Width="35" Height="35"
								Background="Transparent" BorderThickness="0"
								Cursor="Hand" ToolTip="Refresh Mods"
								Click="RefreshModsButton_Click">
					<mahIcons:PackIconMaterial Kind="Refresh" Width="20" Height="20"
																		 Foreground="{StaticResource TB.Txt.Bright}" />
				</Button>
			</Grid>
		</Grid>

		<!--Row 2: Dual Mod Lists with Drag & Drop-->
		<Grid Grid.Row="2" MinHeight="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<ListBox x:Name="LoadOrderListBox" Grid.Column="0" Margin="0,0,10,0"
							 dd:DragDrop.IsDragSource="True"
							 dd:DragDrop.IsDropTarget="True"
							 dd:DragDrop.DropHandler="{Binding}"
							 Style="{StaticResource ModsListBox}"
							 ItemTemplate="{StaticResource ModsModItemTemplate}"
							 ItemsSource="{Binding LoadOrderView}" />
			<ListBox x:Name="AvailableModsListBox" Grid.Column="1" Margin="10,0,0,0"
							 dd:DragDrop.IsDragSource="True"
							 dd:DragDrop.IsDropTarget="True"
							 dd:DragDrop.DropHandler="{Binding}"
							 Style="{StaticResource ModsListBox}"
							 ItemTemplate="{StaticResource ModsModItemTemplate}"
							 ItemsSource="{Binding AvailableModsView}" />
		</Grid>

		<!--Row 3: Status / Toast Messages-->
		<TextBlock Grid.Row="3" Margin="0,6,0,0"
							 Text="{Binding DependencyWarningText}"
							 Foreground="{StaticResource TB.Acc.Amber}"
							 FontFamily="{StaticResource Font.Secondary}"
							 FontSize="12"
							 TextWrapping="Wrap" />

		<!--Row 4: Play Split Button Conjoined left (Play) + right (target dropdown)-->
		<StackPanel Grid.Row="4" Orientation="Horizontal"
								HorizontalAlignment="Center" Margin="0,8,0,0">
			<Button x:Name="PlayButton"
							Content="{Binding PlayButtonText}"
							Style="{StaticResource PlaySplitButtonLeft}"
							IsEnabled="{Binding CanStart}"
							ToolTip="Launch the game with the selected target"
							Click="PlayButton_Click" />
			<Button x:Name="PlayTargetDropdown"
							Style="{StaticResource PlaySplitButtonRight}"
							ToolTip="Choose launch target"
							Click="PlayTargetDropdown_Click">
				<mahIcons:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" />
				<Button.ContextMenu>
					<ContextMenu x:Name="LaunchTargetMenu"
											 Style="{StaticResource ModpacksContextMenu}">
						<MenuItem x:Name="MenuItemBannerlord"
											Style="{StaticResource ModpacksMenuItem}"
											Click="LaunchTarget_Bannerlord_Click">
							<MenuItem.Header>
								<StackPanel Orientation="Horizontal">
									<mahIcons:PackIconMaterial x:Name="CheckBannerlord"
																						 Kind="Check" Width="12" Height="12"
																						 Foreground="{StaticResource TB.Acc.Gold}"
																						 VerticalAlignment="Center"
																						 Margin="0,0,8,0"
																						 Visibility="Visible" />
									<TextBlock Text="Bannerlord" VerticalAlignment="Center" />
								</StackPanel>
							</MenuItem.Header>
						</MenuItem>
						<MenuItem x:Name="MenuItemBLSE"
											Style="{StaticResource ModpacksMenuItem}"
											Click="LaunchTarget_BLSE_Click">
							<MenuItem.Header>
								<StackPanel Orientation="Horizontal">
									<mahIcons:PackIconMaterial x:Name="CheckBLSE"
																						 Kind="Check" Width="12" Height="12"
																						 Foreground="{StaticResource TB.Acc.Gold}"
																						 VerticalAlignment="Center"
																						 Margin="0,0,8,0"
																						 Visibility="Collapsed" />
									<TextBlock Text="BLSE" VerticalAlignment="Center" />
								</StackPanel>
							</MenuItem.Header>
						</MenuItem>
					</ContextMenu>
				</Button.ContextMenu>
			</Button>
		</StackPanel>
	</Grid>
</Page>
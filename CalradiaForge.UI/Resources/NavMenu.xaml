<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:ma="http://metro.mahapps.com/winfx/xaml/controls"
										xmlns:maIcons="http://metro.mahapps.com/winfx/xaml/iconpacks">

	<!--NavMenu Global Styling-->
	<SolidColorBrush x:Key="NavMenuItemHover" Color="#FCE296" />
	<SolidColorBrush x:Key="NavMenuItemSelected" Color="#FF6347" />
	<SolidColorBrush x:Key="NavMenuItemDefault" Color="#C6CFD4" />
 
	

	<!--NavMenu Data Templates-->
	<DataTemplate x:Key="HamburgerMenuItem" DataType="{x:Type ma:HamburgerMenuIconItem}">
		<StackPanel Height="55" MaxWidth="50" CanHorizontallyScroll="False" CanVerticallyScroll="False" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,-10,0" >
			<ContentControl x:Name="IconPart" Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ma:HamburgerMenu}}, Path=CompactPaneLength}" 
												Content="{Binding Icon}" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ma:HamburgerMenu}}, Path=Foreground}"
											Focusable="False" IsTabStop="False" HorizontalAlignment="Left" VerticalAlignment="Center" />
			<TextBlock x:Name="TextPart" Text="{Binding Label}" Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ma:HamburgerMenu}}, Path=CompactPaneLength}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,2,0,0"
											 Foreground="#C6CFD4" FontSize="11" FontWeight="SemiBold" />
		</StackPanel>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ma:HamburgerMenu}}, Path=PanelPlacement}" Value="Right">
				<Setter TargetName="IconPart" Value="Top" />
				<Setter TargetName="TextPart" Property="Margin" Value="0,0,0,0" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<!-- Navigation Menu Styles -->

	
	
	
	
</ResourceDictionary>
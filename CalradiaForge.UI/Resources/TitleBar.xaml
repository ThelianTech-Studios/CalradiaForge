<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	
	
	<!--Colors for Title Bar Buttons -->
	<SolidColorBrush x:Key="MinimizeButtonHover" Color="#FCE296" />
	<SolidColorBrush x:Key="CloseButtonHover" Color="#FF6347" />
	<SolidColorBrush x:Key="DefaultButtonForeground" Color="#C6CFD4" />

	<!--Template for Title Bar Buttons (moved above styles so StaticResource lookups succeed) -->
	<ControlTemplate x:Key="TitleBarIconButtonTemplate" TargetType="Button">
		<Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
          SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="true" />
		</Border>
	</ControlTemplate>

	<!--Custom Styles for Title Bar Buttons -->
	<Style x:Key="TitleBarCloseButton" TargetType="Button">
		<Setter Property="{x:Static Control.TemplateProperty}" Value="{StaticResource TitleBarIconButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource DefaultButtonForeground}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="50" />
		<Setter Property="Height" Value="50" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource CloseButtonHover}" />
				<Setter Property="Background" Value="Transparent" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Opacity" Value="0.85" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TitleBarMinimizeButton" TargetType="Button">
		<Setter Property="{x:Static Control.TemplateProperty}" Value="{StaticResource TitleBarIconButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource DefaultButtonForeground}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="50" />
		<Setter Property="Height" Value="50" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource MinimizeButtonHover }" />
				<Setter Property="Background" Value="Transparent" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Opacity" Value="0.85" />
			</Trigger>
		</Style.Triggers>
	</Style>
	
	<!--End of TitleBar Resources-->
</ResourceDictionary>
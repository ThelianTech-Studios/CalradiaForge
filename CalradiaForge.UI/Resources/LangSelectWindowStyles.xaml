<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ══════════════════════════════════════════════════════
	     Language Select Window — Title Bar
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LangSelectTitleBar" TargetType="Grid">
		<Setter Property="Background" Value="{StaticResource TB.Bg.Lighter}" />
		<Setter Property="Height" Value="40" />
	</Style>

	<Style x:Key="LangSelectTitleBarText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="FontWeight" Value="Bold" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Language Select Window — Header / Text
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LangSelectWindowTitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
		<Setter Property="FontSize" Value="36" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<Style x:Key="LangSelectSubtitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Mid}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="TextAlignment" Value="Center" />
	</Style>

	<Style x:Key="LangSelectLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Language Select Window — Container
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="LangSelectPanelBorder" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource TB.Sfc.MedLight.50}" />
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.Lighter.75}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="14" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Language Select Window — Continue Button
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="LangSelectContinueButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Gold}"
						BorderThickness="0"
						CornerRadius="6"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
												RecognizesAccessKey="True" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Sfc.MedLight}" />
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
				<Setter Property="Foreground"
								Value="{StaticResource TB.Txt.Dim}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="LangSelectContinueButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource LangSelectContinueButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="Height" Value="36" />
		<Setter Property="MinWidth" Value="140" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

</ResourceDictionary>
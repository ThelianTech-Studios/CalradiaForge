<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:mahIcons="http://metro.mahapps.com/winfx/xaml/iconpacks">

	<!-- ══════════════════════════════════════════════════════
	     Settings Nav Bar — Horizontal ListBox
	     Uses DockPanel so About can dock right.
	     Background matches the vertical HamburgerMenu pane.
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsNavBar" TargetType="ListBox">
		<Setter Property="Background" Value="{StaticResource TB.Bg.MedLight.50}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBox">
					<Border Background="{TemplateBinding Background}"
									CornerRadius="10"
									Padding="{TemplateBinding Padding}"
									SnapsToDevicePixels="True">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<DockPanel LastChildFill="False" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Settings Nav Item — Horizontal icon + label
	     Mirrors HamburgerMenu triggers:
	       Default:  TB.Txt.Bright icon + text, transparent bg
	       Hover:    TB.Acc.Gold icon + text
	       Selected: TB.Acc.DeepOrange icon + text, TB.Sfc.Light bg
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<Border x:Name="NavItemBorder"
									Background="Transparent"
									CornerRadius="8"
									Padding="12,8"
									Margin="2,4"
									SnapsToDevicePixels="True">
						<StackPanel Orientation="Horizontal"
												VerticalAlignment="Center"
												HorizontalAlignment="Center">
							<ContentPresenter x:Name="IconPart"
																ContentSource="Tag"
																Focusable="False"
																VerticalAlignment="Center"
																Margin="0,0,7,0" />
							<TextBlock x:Name="TextPart"
												 Text="{TemplateBinding Content}"
												 FontFamily="{StaticResource Font.Secondary}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="{StaticResource TB.Txt.Bright}"
												 VerticalAlignment="Center" />
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="TextPart" Property="Foreground"
											Value="{StaticResource TB.Acc.Gold}" />
							<Setter TargetName="IconPart" Property="TextElement.Foreground"
											Value="{StaticResource TB.Acc.Gold}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="TextPart" Property="Foreground"
											Value="{StaticResource TB.Acc.DeepOrange}" />
							<Setter TargetName="IconPart" Property="TextElement.Foreground"
											Value="{StaticResource TB.Acc.DeepOrange}" />
							<Setter TargetName="NavItemBorder" Property="Background"
											Value="{StaticResource TB.Sfc.Light}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Settings Nav Item — Right-docked variant (About)
	     Same visual as SettingsNavItem but docked right.
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsNavItemRight" TargetType="ListBoxItem"
				 BasedOn="{StaticResource SettingsNavItem}">
		<Setter Property="DockPanel.Dock" Value="Right" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Section Header (group labels inside tabs)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsSectionHeader" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Margin" Value="0,0,0,8" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Setting Label (left-side label for each setting row)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,12,0" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Setting Description (hint text under a setting)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsHint" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dim}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontStyle" Value="Italic" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Margin" Value="0,2,0,0" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Path Display — read-only styled text block for paths
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsPathDisplay" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="Padding" Value="8,6" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Path Container — Border around path + button row
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsPathBorder" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource TB.Sfc.Dark.50}" />
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.MedDark.50}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Validation Status Text (✓ or ✗ beneath path rows)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsValidationOk" TargetType="TextBlock">
		<Setter Property="Foreground" Value="#6BBF6B" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,2,0,0" />
	</Style>

	<Style x:Key="SettingsValidationError" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Acc.Red}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,2,0,0" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Action Button (tools, browse, re-detect)
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="SettingsActionButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Acc.Orange}"
						BorderThickness="0" CornerRadius="6"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
												RecognizesAccessKey="True" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Acc.Amber}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="SettingsActionButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource SettingsActionButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Dark}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="Height" Value="34" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Secondary / Tool Button (dark surface background)
	     ══════════════════════════════════════════════════════ -->
	<ControlTemplate x:Key="SettingsToolButtonTemplate" TargetType="Button">
		<Border x:Name="ButtonBorder"
						Background="{StaticResource TB.Sfc.MedDark}"
						BorderThickness="1"
						BorderBrush="{StaticResource TB.Sfc.Lighter.75}"
						CornerRadius="6"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
			<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
												RecognizesAccessKey="True" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonBorder" Property="Background"
								Value="{StaticResource TB.Sfc.Med}" />
				<Setter TargetName="ButtonBorder" Property="BorderBrush"
								Value="{StaticResource TB.Acc.Gold}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="SettingsToolButton" TargetType="Button">
		<Setter Property="Template" Value="{StaticResource SettingsToolButtonTemplate}" />
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="14,6" />
		<Setter Property="Height" Value="34" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     Section Group Border (card-like container for groups)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsSectionBorder" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource TB.Sfc.Darkest.25}" />
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.MedDark.50}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="16,12" />
		<Setter Property="Margin" Value="0,0,0,12" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     ToggleSwitch — MahApps Metro, themed to CalradiaForge
	     Off:   TB.Sfc.MedDark track, TB.Txt.Mid thumb
	     On:    TB.Acc.Orange track, TB.Acc.Gold thumb
	     Hover: TB.Acc.Gold border highlight
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsToggleSwitch" TargetType="mah:ToggleSwitch">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="ContentDirection" Value="RightToLeft" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="OffSwitchBrush" Value="{StaticResource TB.Sfc.MedDark}" />
		<Setter Property="OnSwitchBrush" Value="{StaticResource TB.Acc.Orange}" />
		<Setter Property="ThumbIndicatorBrush" Value="{StaticResource TB.Txt.Mid}" />
		<Setter Property="ThumbIndicatorDisabledBrush" Value="{StaticResource TB.Txt.Dim}" />
		<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.Lighter.75}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="ToggleSwitchButtonStyle">
			<Setter.Value>
				<Style TargetType="mah:ToggleSwitchButton">
					<Setter Property="Background" Value="{StaticResource TB.Sfc.MedDark}" />
					<Setter Property="BorderBrush" Value="{StaticResource TB.Sfc.Lighter.75}" />
					<Setter Property="BorderThickness" Value="1" />
					<Setter Property="SnapsToDevicePixels" Value="True" />
					<Setter Property="ThumbIndicatorBrush" Value="{StaticResource TB.Txt.Mid}" />
					<Setter Property="OffSwitchBrush" Value="{StaticResource TB.Sfc.MedDark}" />
					<Setter Property="OnSwitchBrush" Value="{StaticResource TB.Acc.Orange}" />
					<Style.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter Property="ThumbIndicatorBrush" Value="{StaticResource TB.Acc.Gold}" />
							<Setter Property="BorderBrush" Value="{StaticResource TB.Acc.Orange}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="BorderBrush" Value="{StaticResource TB.Acc.Gold}" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     RadioButton (for Modpack Startup Mode)
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsRadioButton" TargetType="RadioButton">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Margin" Value="0,3" />
	</Style>

	<!-- ══════════════════════════════════════════════════════
	     About Page Title
	     ══════════════════════════════════════════════════════ -->
	<Style x:Key="SettingsAboutTitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
		<Setter Property="FontSize" Value="36" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<Style x:Key="SettingsAboutVersion" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Mid}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,2,0,0" />
	</Style>

	<Style x:Key="SettingsAboutLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Mid}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style x:Key="SettingsAboutValue" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource TB.Txt.Bright}" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Secondary}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="8,0,0,0" />
	</Style>

	<!--End of SettingsPage Resources-->
</ResourceDictionary>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CalradiaForge.UI.App</StartupObject>
    <RootNamespace>CalradiaForge.UI</RootNamespace>
    <SignAssembly>False</SignAssembly>
    <Title>CalradiaForge Launcher</Title>
    <Authors>ThelianTech</Authors>
    <Product>$(Title)</Product>
    <Copyright>Copyright © 2026 ThelianTech™</Copyright>
    <Description>An alternative game launcher for Mount &amp; Blade II: Bannerlord</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSymbols>False</IncludeSymbols>
    <PackageProjectUrl>https://github.com/ThelianTech/CalradiaForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ThelianTech/CalradiaForge</RepositoryUrl>
    <PackageReleaseNotes>Beta v0.9.22</PackageReleaseNotes>
    <Version>0.9.22</Version>
    <PackageLicenseFile>EULA.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\App_Icon.png" />
    <None Remove="Resources\EULA.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalradiaForge.Core\CalradiaForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\App_Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Copy language JSON files and manifest to output Languages\ folder -->
  <ItemGroup>
    <None Include="..\Languages\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Languages" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\EULA.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\EULA.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

<Window x:Class="CalradiaForge.UI.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalradiaForge - End User License Agreement"
        Width="760" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize">
	<Control.Background>
		<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
			<GradientStop Color="{StaticResource TC.Bg.Lightest}" Offset="0.0" />
			<GradientStop Color="{StaticResource TC.Bg.Lighter}" Offset="0.1" />
			<GradientStop Color="{StaticResource TC.Bg.Light}" Offset="0.2" />
			<GradientStop Color="{StaticResource TC.Bg.MedLight}" Offset="0.3" />
			<GradientStop Color="{StaticResource TC.Bg.Med}" Offset="0.4" />
			<GradientStop Color="{StaticResource TC.Bg.MedDark}" Offset="0.5" />
			<GradientStop Color="{StaticResource TC.Bg.Dark}" Offset="0.6" />
			<GradientStop Color="{StaticResource TC.Bg.Darkest}" Offset="1.0" />
		</LinearGradientBrush>
	</Control.Background>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Title Bar -->
		<Grid Grid.Row="0" Style="{StaticResource EulaTitleBar}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
									Margin="10,0,5,0">
				<Image Source="/Resources/App_Icon.png" Width="30" Height="30" Margin="0,0,8,0" />
				<TextBlock Text="CalradiaForge" VerticalAlignment="Center"
									 Style="{StaticResource EulaTitleBarText}" />
			</StackPanel>
			<Border Grid.Column="1" Background="Transparent"
							MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
			<Button Grid.Column="2" Click="CloseButton_Click"
							Style="{StaticResource TitleBarCloseButton}"
							ToolTip="Close" />
		</Grid>

		<!-- Content -->
		<Grid Grid.Row="1" Margin="24,12,24,24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Header -->
			<TextBlock Grid.Row="0" Text="End User License Agreement"
								 Style="{StaticResource EulaWindowTitle}" />

			<!-- Version label -->
			<TextBlock Grid.Row="1" Text="EULA Version 1.2"
								 Style="{StaticResource EulaVersionLabel}" />

			<!-- EULA text in scrollable container -->
			<Border Grid.Row="2" Style="{StaticResource EulaScrollBorder}">
				<Border CornerRadius="7" ClipToBounds="True">
					<TextBox x:Name="EulaTextBox"
									 Style="{StaticResource EulaTextDisplay}" />
				</Border>
			</Border>

			<!-- Acceptance toggle switch -->
			<CheckBox Grid.Row="3" x:Name="AcceptCheckBox"
								Content="I have read and agree to the End User License Agreement"
								Style="{StaticResource SettingsToggleSwitch}"
								Margin="0,12,0,12" />

			<!-- Buttons -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Decline" Click="DeclineButton_Click"
								Style="{StaticResource EulaDeclineButton}"
								Margin="0,0,12,0" />
				<Button x:Name="AcceptButton" Content="Accept" Click="AcceptButton_Click"
								Style="{StaticResource EulaAcceptButton}"
								IsEnabled="{Binding IsChecked, ElementName=AcceptCheckBox}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>CalradiaForge.Core</Title>
    <Authors>ThelianTech</Authors>
    <Version>0.9.38</Version>
    <Copyright>Copyright © 2026 ThelianTech™</Copyright>
    <PackageProjectUrl>https://github.com/ThelianTech/CalradiaForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ThelianTech/CalradiaForge</RepositoryUrl>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.44.5" />
  </ItemGroup>

</Project>
